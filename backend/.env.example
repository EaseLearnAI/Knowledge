NODE_ENV=development
PORT=3100
HOST=127.0.0.1

# 已填写数据库名，可直接连接本机 MongoDB。
MONGODB_URI=mongodb://localhost:27017/memo_knowledge

# 正式环境必须替换为至少 32 字节的随机字符串。
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# 用英文逗号分隔；本地开发可保留原型和 iOS 调试地址。
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# 复用已验证可用的本地 videosummarize CLI。
VIDEOSUMMARIZE_BIN=/Users/mac/Desktop/03_学习与研究/study/视频解析学习/skill方案/cliskill/.venv/bin/videosummarize
VIDEOSUMMARIZE_WORKSPACE=./storage/workspaces
VIDEO_PROCESSOR=cli

# local 无需外部 API；minimax 需要填写以下三项。
# 后续切换同一 MiniMax 接口下的模型时，只修改 MINIMAX_MODEL。
COPYWRITER_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimaxi.com
MINIMAX_MODEL=MiniMax-M3

# Web 终端只用于本地调试。生产环境应关闭。
ENABLE_WEB_TERMINAL=true
WEB_TERMINAL_TOKEN=dev-terminal-token-change-me
LOG_LEVEL=info
