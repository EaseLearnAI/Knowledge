NODE_ENV=development
PORT=3100
HOST=127.0.0.1

# 已填写数据库名，可直接连接本机 MongoDB。
MONGODB_URI=mongodb://localhost:27017/memo_knowledge

# 正式环境必须替换为至少 32 字节的随机字符串。
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# 用英文逗号分隔；本地开发可保留原型和 iOS 调试地址。
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
# 生产环境必填。火山通过这个 HTTPS 地址拉取 B站音频代理流。
# PUBLIC_BASE_URL=https://api.example.com
MEDIA_PROXY_TTL_SECONDS=14400

# volc_asr=生产默认的火山大模型录音识别；ark=方舟音频实验；cli=仅本地开发；mock=测试。
VIDEOSUMMARIZE_BIN=/Users/mac/Desktop/03_学习与研究/study/视频解析学习/skill方案/cliskill/.venv/bin/videosummarize
VIDEOSUMMARIZE_WORKSPACE=./storage/workspaces
# B站公开链接不需要 Chrome/Cookie；小红书、抖音等平台如果触发风控，
# 服务器只挂载 Netscape 格式 Cookie 密钥文件，不读取开发者电脑的浏览器。
# 不要把 Cookie 内容或真实文件提交到 Git。
# VIDEO_COOKIE_BROWSER=chrome
# VIDEO_COOKIE_FILE=/run/secrets/video-cookies.txt
VIDEO_PROCESSOR=volc_asr

# 火山大模型录音文件识别是生产主链路；只从运行环境注入真实凭证。
# B站由后端公开 player API 获取最低码率音频流，再通过带 HMAC 签名的服务端代理
# 交给火山云端拉取和转写；不落盘、不运行本地模型。
VOLC_ASR_APP_ID=
VOLC_ASR_ACCESS_TOKEN=
VOLC_ASR_API_BASE=https://openspeech.bytedance.com/api/v3/auc/bigmodel
VOLC_ASR_RESOURCE_ID=volc.bigasr.auc
VOLC_ASR_POLL_INTERVAL_MS=5000
# 标准版官方承诺 3 小时内完成；超时必须覆盖这个窗口。
VOLC_ASR_TIMEOUT_MS=10800000
VOLC_ASR_MAX_ATTEMPTS=3

# 火山方舟默认分段转写长音频，并根据逐字稿生成结构化总结。
# 密钥必须从运行环境注入，禁止提交真实值。
ARK_API_KEY=
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
ARK_AUDIO_MODEL=doubao-seed-2-0-lite-260428
ARK_SUMMARY_MODEL=doubao-seed-2-0-mini-260428
# 主模型额度耗尽、服务暂停或未开通时按顺序自动降级
ARK_SUMMARY_FALLBACK_MODELS=doubao-seed-2-0-lite-260428
ARK_REQUEST_TIMEOUT_MS=300000

# local=规则摘要；ark=火山方舟；minimax=MiniMax OpenAI 兼容接口。
COPYWRITER_PROVIDER=ark
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimaxi.com
MINIMAX_MODEL=MiniMax-M3

# Web 终端只用于本地调试。生产环境应关闭。
ENABLE_WEB_TERMINAL=true
WEB_TERMINAL_TOKEN=dev-terminal-token-change-me
LOG_LEVEL=info
